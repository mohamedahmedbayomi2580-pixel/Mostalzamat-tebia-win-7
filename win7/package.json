{
  "name": "cashier-win7",
  "version": "1.0.0",
  "description": "Cashier POS (Windows 7)",
  "author": "Cashier",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --ia32 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mycashier.win7",
    "productName": "Cashier",
    "files": ["main.js", "www/**/*"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Cashier-Win7-Setup-${arch}.${ext}" },
    "portable": { "artifactName": "Cashier-Win7-Portable-${arch}.${ext}" }
  }
}
